# Copy to `.env` and fill values locally. Never commit `.env`.
# Netlify / Render: set the same keys in the host dashboard.

# --- Google OAuth (optional; waitlist / Gmail flows) ---
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backend API ---
# Leave empty for relative `/api/*` (proxied). Or set absolute API origin.
VITE_API_BASE_URL=

# --- Supabase ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: waitlist query budget (default 10000ms). Avoid <3000 on cold Render.
# SUPABASE_WAITLIST_TIMEOUT_MS=10000
# SUPABASE_CIRCUIT_MS=20000

# --- Backoffice (/admin) ---
ADMIN_PASSWORD=
ADMIN_EMAILS=
ADMIN_SESSION_SECRET=

# --- Public site URL ---
VITE_ADMIN_PORTAL_URL=

# --- Onboarding email (Express only) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Hubble gift cards (Express only) ---
HUBBLE_CLIENT_ID=
HUBBLE_CLIENT_SECRET=
HUBBLE_API_BASE=
# Same secret as Hubble dashboard → Webhook Signature (HMAC for X-Verify)
HUBBLE_WEBHOOK_SECRET=

# --- CueLinks marketplace (Express only) ---
CUELINKS_API_TOKEN=
CUELINKS_API_BASE=
CUELINKS_OFFERS_PATH=
CUELINKS_INDIA_ONLY=true
