# Copy to .env. For the static Hostinger + Cloudflare deploy, build with these
# vars set, then upload the built dist/ (includes dist/.htaccess) to the
# Hostinger web root. Cloudflare sits in front for DNS/CDN.


# --- Backend API ---
# Leave EMPTY to use relative /api/* paths, which dist/.htaccess proxies to
# the Render backend (needs mod_proxy on the host). If mod_proxy is not
# available, set this to the backend origin so the browser calls it directly
# (backend already sends CORS):
#   VITE_API_BASE_URL=https://yureka-api.onrender.com
VITE_API_BASE_URL=

# --- Supabase (Goldback + Auth) ---
# Project: https://hnykwiqiducomdspbxlj.supabase.co
VITE_SUPABASE_URL=https://hnykwiqiducomdspbxlj.supabase.co
VITE_SUPABASE_ANON_KEY=
# Server-only (Express goldback routes). Prefer service role for writes.
SUPABASE_URL=https://hnykwiqiducomdspbxlj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Without keys, Goldback + admin persist to data/*.json locally.

# --- Backoffice (/admin) ---
ADMIN_PASSWORD=yureka-admin
ADMIN_EMAILS=admin@yureka.one
ADMIN_SESSION_SECRET=

# --- Public site URLs (now on yureka.one) ---
VITE_ADMIN_PORTAL_URL=https://yureka.one

# --- Onboarding email (server-side, only if running server.ts) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Hubble gift cards (server-only; staging by default) ---
HUBBLE_CLIENT_ID=
HUBBLE_CLIENT_SECRET=
HUBBLE_API_BASE=https://api.dev.myhubble.money

# --- CueLinks affiliate marketplace (server-only) ---
CUELINKS_API_TOKEN=
CUELINKS_API_BASE=https://www.cuelinks.com/api/v2
CUELINKS_OFFERS_PATH=/offers.json
CUELINKS_INDIA_ONLY=true
