# ============================================================
#  Yureka.One — static SPA on Hostinger (Apache) behind Cloudflare
#  Replaces the retired netlify.toml (now in archive/).
#  Ships from public/.htaccess → copied to dist/.htaccess at build,
#  deploy the built dist/ to the Hostinger web root.
# ============================================================

RewriteEngine On

# --- API proxy → backend (still on Render) -------------------
#  The frontend calls relative /api/* paths (see lib/api/client.ts);
#  proxy them to the existing backend. Requires mod_proxy +
#  mod_proxy_http enabled on the hosting plan.
#  If your Hostinger plan does NOT allow mod_proxy, delete this block
#  and build with  VITE_API_BASE_URL=https://yureka-api.onrender.com
#  so the browser hits the backend directly (it already sends CORS).
RewriteRule ^api/(.*)$ https://yureka-api.onrender.com/api/$1 [P,L]

# --- SPA fallback (React Router) -----------------------------
#  Real files and directories are served as-is; every other path
#  falls back to index.html so client-side routing can take over.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ /index.html [L]

# --- Caching -------------------------------------------------
<IfModule mod_headers.c>
  # Vite-fingerprinted assets are immutable — cache hard for a year.
  SetEnvIf Request_URI "^/assets/" IMMUTABLE_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET

  # HTML must always revalidate so new deploys are picked up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression ---------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
    application/javascript application/json image/svg+xml application/xml
</IfModule>

# --- Security niceties ---------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
